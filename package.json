{
  "name": "ezeng",
  "productName": "EzEng",
  "version": "1.7.0",
  "description": "EzEng — приложение для изучения английского языка для ПК",
  "main": "electron/main.cjs",
  "private": true,
  "author": "levkaster",
  "license": "MIT",
  "homepage": "https://github.com/levkastergit/ezeng",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "icon": "node scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.levkaster.ezeng",
    "productName": "EzEng",
    "copyright": "Copyright © 2026 levkaster",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EzEng",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "language": "1049",
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "levkastergit",
        "repo": "ezeng",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
